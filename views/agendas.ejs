<%# Home page (route "/agendas"). Locals: user (optional, the logged-in user), error (optional).
    The agendas and taches are loaded and drawn by agendas.js. %>
<%
    // Colors offered for a new agenda
    const swatches = [
        { value: '#3b82f6', name: 'Bleu' },
        { value: '#8b5cf6', name: 'Violet' },
        { value: '#ec4899', name: 'Rose' },
        { value: '#ef4444', name: 'Rouge' },
        { value: '#f97316', name: 'Orange' },
        { value: '#eab308', name: 'Jaune' },
        { value: '#10b981', name: 'Vert' },
        { value: '#14b8a6', name: 'Turquoise' },
    ];
%>
<!DOCTYPE html>
<html lang="fr">
<%- include('partials/head', { title: 'Mes agendas' }) %>
<body>
<header class="topbar">
    <%- include('partials/brand', { href: '/agendas' }) %>

    <!-- Week navigation -->
    <div class="week-nav">
        <button id="today-btn" type="button" class="btn btn-glass">Aujourd'hui</button>
        <button id="prev-week" type="button" class="btn btn-glass btn-round" aria-label="Semaine précédente">‹</button>
        <button id="next-week" type="button" class="btn btn-glass btn-round" aria-label="Semaine suivante">›</button>
        <h2 id="week-label" class="week-label"></h2>
    </div>

    <div class="user">
        <span id="current-user"><%= locals.user ? user.username : '' %></span>
        <button id="logout-btn" type="button" class="btn btn-glass">Se déconnecter</button>
    </div>
</header>

<main class="home">
    <!-- Left: create, mini calendar, list of agendas -->
    <aside class="sidebar glass">
        <div class="sidebar-scroll">
            <button id="create-btn" type="button" class="btn btn-create"
                    aria-haspopup="dialog" aria-expanded="false" aria-controls="create-dialog">
                <span class="btn-icon-glyph" aria-hidden="true">+</span>
                <span>Créer</span>
            </button>

            <%- include('partials/error') %>

            <section class="mini-cal" aria-label="Choisir une semaine">
                <div class="mini-head">
                    <h2 id="mini-label"></h2>
                    <div class="mini-nav">
                        <button id="mini-prev" type="button" class="btn btn-round btn-small" aria-label="Mois précédent">‹</button>
                        <button id="mini-next" type="button" class="btn btn-round btn-small" aria-label="Mois suivant">›</button>
                    </div>
                </div>
                <div class="mini-weekdays" aria-hidden="true">
                    <span>L</span><span>M</span><span>M</span><span>J</span><span>V</span><span>S</span><span>D</span>
                </div>
                <div id="mini-grid" class="mini-grid"></div>
            </section>

            <section class="agenda-section">
                <h2 class="section-title">Mes agendas</h2>
                <div class="agenda-list-wrap">
                    <span id="agenda-lens" class="agenda-lens" aria-hidden="true"></span>
                    <ul id="agenda-list" class="agenda-list"></ul>
                </div>
                <p id="empty" class="hint" hidden>Aucun agenda pour l'instant. Appuyez sur Créer pour en ajouter un.</p>
            </section>
        </div>
    </aside>

    <!-- Right: week view -->
    <section class="calendar glass" aria-label="Semaine">
        <p id="calendar-hint" class="calendar-hint"></p>
        <div id="week-body" class="week-body">
            <div class="week-head">
                <span id="tz-label" class="tz-label"></span>
                <div id="week-days" class="week-days"></div>
            </div>
            <div class="week-grid">
                <div id="hours" class="hours" aria-hidden="true"></div>
                <div id="week-columns" class="week-columns"></div>
            </div>
        </div>
    </section>
</main>

<!-- Creation sheet: rises from the bottom center of the screen -->
<dialog id="create-dialog" class="create-sheet" aria-labelledby="create-title">
    <form id="create-form" class="sheet-form" novalidate>
        <span class="sheet-grabber" aria-hidden="true"></span>

        <div class="sheet-head">
            <h2 id="create-title" class="visually-hidden">Créer</h2>
            <div class="segmented" role="radiogroup" aria-label="Que voulez-vous créer ?">
                <input id="kind-tache" type="radio" name="kind" value="tache" checked>
                <label for="kind-tache">Tâche</label>
                <input id="kind-agenda" type="radio" name="kind" value="agenda">
                <label for="kind-agenda">Agenda</label>
                <span class="segmented-thumb" aria-hidden="true"></span>
            </div>
            <button id="close-dialog" type="button" class="btn btn-glass btn-round" aria-label="Fermer">×</button>
        </div>

        <!-- Tache -->
        <fieldset id="tache-fields" class="sheet-fields">
            <legend class="visually-hidden">Nouvelle tâche</legend>

            <div id="tache-inputs" class="sheet-fields-inner">
                <input id="tache-title" type="text" class="title-input" placeholder="Ajouter un titre" aria-label="Titre" autocomplete="off">

                <div class="field-row">
                    <div class="field">
                        <label for="tache-date">Date</label>
                        <input id="tache-date" type="date">
                    </div>
                    <div class="field">
                        <label for="tache-start">Début</label>
                        <input id="tache-start" type="time" step="300">
                    </div>
                    <div class="field">
                        <label for="tache-end">Fin</label>
                        <input id="tache-end" type="time" step="300">
                    </div>
                </div>

                <div class="field">
                    <span id="picker-label" class="field-label">Agendas</span>
                    <button id="picker-btn" type="button" class="picker-btn"
                            aria-labelledby="picker-label picker-btn" aria-expanded="false" aria-controls="picker-panel">
                        <span id="picker-chips" class="picker-chips"></span>
                    </button>
                    <div id="picker-panel" class="picker-panel" inert>
                        <div class="picker-clip">
                            <ul id="picker-options" class="picker-options" aria-label="Agendas de la tâche"></ul>
                        </div>
                    </div>
                </div>

                <div class="field">
                    <label for="tache-location">Lieu <span class="optional">facultatif</span></label>
                    <input id="tache-location" type="text" placeholder="Salle 101" autocomplete="off">
                </div>

                <div class="field">
                    <label for="tache-description">Description <span class="optional">facultatif</span></label>
                    <textarea id="tache-description" rows="2" placeholder="Ajouter des détails"></textarea>
                </div>
            </div>

            <p id="no-agenda-note" class="sheet-note" hidden>
                Une tâche appartient à un agenda. Créez d'abord votre premier agenda.
                <button id="go-agenda-btn" type="button" class="link-btn">Créer un agenda</button>
            </p>
        </fieldset>

        <!-- Agenda -->
        <fieldset id="agenda-fields" class="sheet-fields" hidden>
            <legend class="visually-hidden">Nouvel agenda</legend>

            <input id="agenda-name" type="text" class="title-input" placeholder="Nom de l'agenda" aria-label="Nom" autocomplete="off">

            <div class="field">
                <span id="color-label" class="field-label">Couleur</span>
                <div class="swatches" role="radiogroup" aria-labelledby="color-label">
                    <% swatches.forEach((swatch, i) => { %>
                    <label class="swatch" style="--swatch: <%= swatch.value %>"><input type="radio" name="color" value="<%= swatch.value %>"<%= i === 0 ? ' checked' : '' %> aria-label="<%= swatch.name %>"><span></span></label>
                    <% }) %>
                    <label class="swatch swatch-custom" title="Autre couleur">
                        <input id="color-custom-radio" type="radio" name="color" value="#1c1e3a" aria-label="Autre couleur">
                        <span></span>
                        <input id="color-custom" type="color" value="#1c1e3a" tabindex="-1" aria-hidden="true">
                    </label>
                </div>
            </div>

            <div id="agenda-preview" class="agenda-preview" aria-hidden="true">
                <span class="agenda-dot"></span>
                <span id="agenda-preview-name" class="agenda-name">Nom de l'agenda</span>
            </div>
        </fieldset>

        <p id="dialog-error" class="error" role="alert" hidden></p>

        <div class="sheet-footer">
            <button id="cancel-btn" type="button" class="btn btn-glass">Annuler</button>
            <button id="save-btn" type="submit" class="btn btn-primary">Créer la tâche</button>
        </div>
    </form>
</dialog>

<!-- Details of a tache: opens beside its card in the week view -->
<dialog id="event-dialog" class="event-pop" aria-labelledby="event-title">
    <div class="event-pop-inner">
        <div class="event-pop-head">
            <span class="event-pop-dot" aria-hidden="true"></span>
            <h2 id="event-title"></h2>
            <button id="event-close" type="button" class="btn btn-glass btn-round btn-small" aria-label="Fermer">×</button>
        </div>

        <dl class="event-details">
            <div class="detail-row">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                <dt class="visually-hidden">Quand</dt>
                <dd id="event-when"></dd>
            </div>
            <div id="event-location-row" class="detail-row">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
                <dt class="visually-hidden">Lieu</dt>
                <dd id="event-location"></dd>
            </div>
            <div class="detail-row">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="3"/><path d="M3.5 10h17M8 3v4M16 3v4"/></svg>
                <dt class="visually-hidden">Agenda</dt>
                <dd><span id="event-agenda" class="chip"></span></dd>
            </div>
            <div class="detail-row">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 6h14M5 11h14M5 16h9"/></svg>
                <dt class="visually-hidden">Description</dt>
                <dd id="event-description" class="event-description"></dd>
            </div>
        </dl>
    </div>
</dialog>

<%- include('partials/scripts', { script: 'agendas.js' }) %>
</body>
</html>
