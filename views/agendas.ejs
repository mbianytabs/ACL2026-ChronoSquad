<%
    const swatches = [
        { value: '#3b82f6', name: 'Bleu' },
        { value: '#8b5cf6', name: 'Violet' },
        { value: '#ec4899', name: 'Rose' },
        { value: '#ef4444', name: 'Rouge' },
        { value: '#f97316', name: 'Orange' },
        { value: '#eab308', name: 'Jaune' },
        { value: '#10b981', name: 'Vert' },
        { value: '#14b8a6', name: 'Turquoise' },
    ];
%>

<!DOCTYPE html>
<html lang="fr">

<%- include('partials/head', { title: 'Mes agendas' }) %>

<body>

<header class="topbar">

    <%- include('partials/brand', { href: '/agendas' }) %>

    <!-- NAVIGATION SEMAINE -->
    <div class="week-nav">

        <button
            id="today-btn"
            type="button"
            class="btn btn-glass"
        >
            Aujourd'hui
        </button>

        <button
            id="prev-week"
            type="button"
            class="btn btn-glass btn-round"
            aria-label="Semaine précédente"
        >
            ‹
        </button>

        <button
            id="next-week"
            type="button"
            class="btn btn-glass btn-round"
            aria-label="Semaine suivante"
        >
            ›
        </button>

        <h2
            id="week-label"
            class="week-label"
        ></h2>

    </div>


    <!-- ================================================= -->
    <!-- RECHERCHE DE RENDEZ-VOUS                          -->
    <!-- ================================================= -->

    <div class="search-area">

        <div class="search-bar">

            <label class="search-field">

                <svg
                    class="search-icon"
                    viewBox="0 0 20 20"
                    width="16"
                    height="16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.9"
                    stroke-linecap="round"
                    aria-hidden="true"
                >
                    <circle cx="8.75" cy="8.75" r="5.75"/>
                    <path d="M13 13l4.25 4.25"/>
                </svg>

                <input
                    id="search-input"
                    type="search"
                    placeholder="Rechercher un rendez-vous..."
                    autocomplete="off"
                    aria-label="Rechercher un rendez-vous"
                >

            </label>

            <button
                id="search-filter-btn"
                type="button"
                class="btn btn-glass"
                aria-label="Afficher les critères de recherche"
                aria-expanded="false"
                aria-controls="search-filters"
            >
                Filtres
                <span
                    id="search-filter-count"
                    class="search-filter-count"
                    hidden
                ></span>
            </button>

        </div>


        <!-- CRITÈRES QUI AFFINENT LA RECHERCHE -->

        <div
            id="search-filters"
            class="search-filters"
            role="group"
            aria-labelledby="search-filters-title"
            hidden
        >

            <div class="search-filters-head">
                <h2 id="search-filters-title">
                    Affiner les résultats
                </h2>
                <p class="search-filters-hint">
                    Ces critères s'ajoutent au texte recherché. Tous sont facultatifs.
                </p>
            </div>


            <!-- PÉRIODE -->
            <fieldset class="search-period">

                <legend>
                    Période
                </legend>

                <div class="search-period-row">

                    <div class="field">
                        <label for="search-start-date">
                            Du
                        </label>
                        <input
                            id="search-start-date"
                            type="date"
                        >
                    </div>

                    <div class="field">
                        <label for="search-end-date">
                            Au
                        </label>
                        <input
                            id="search-end-date"
                            type="date"
                        >
                    </div>

                </div>

                <p
                    id="search-period-error"
                    class="error"
                    role="alert"
                    hidden
                >
                    La date de début doit précéder la date de fin.
                </p>

            </fieldset>


            <!-- TITRE -->
            <div class="field">

                <label for="search-title">
                    Titre
                </label>

                <input
                    id="search-title"
                    type="text"
                    placeholder="Ex. Réunion"
                    autocomplete="off"
                >

            </div>


            <!-- AGENDA -->
            <div class="field">

                <label for="search-agenda">
                    Agenda
                </label>

                <select id="search-agenda">

                    <option value="">
                        Tous les agendas
                    </option>

                </select>

            </div>


            <!-- LIEU -->
            <div class="field">

                <label for="search-location">
                    Lieu
                </label>

                <input
                    id="search-location"
                    type="text"
                    placeholder="Ex. Salle 101"
                    autocomplete="off"
                >

            </div>


            <div class="search-filter-actions">

                <button
                    id="search-reset-btn"
                    type="button"
                    class="btn btn-glass"
                >
                    Réinitialiser les critères
                </button>

                <button
                    id="search-submit-btn"
                    type="button"
                    class="btn btn-primary"
                >
                    Appliquer
                </button>

            </div>

        </div>


        <!-- RÉSULTATS DE RECHERCHE -->

        <div
            id="search-results"
            class="search-results"
            hidden
        >

            <p
                id="search-results-count"
                class="search-results-count"
            ></p>

            <ul
                id="search-results-list"
                class="search-results-list"
                aria-label="Résultats de recherche"
            ></ul>

            <p
                id="search-empty"
                class="search-empty"
                hidden
            >
                Aucun rendez-vous trouvé.
            </p>

        </div>

    </div>


    <!-- UTILISATEUR -->
    <div class="user">

        <span id="current-user">
            <%= locals.user ? user.username : '' %>
        </span>

        <a href="/parametres" class="btn btn-glass btn-round settings-link" aria-label="Paramètres" title="Paramètres">
            <span aria-hidden="true">⚙</span>
        </a>

        <button
            id="logout-btn"
            type="button"
            class="btn btn-glass"
        >
            Se déconnecter
        </button>

    </div>

</header>


<main class="home" data-calendar-state="loading">

    <!-- ========================= -->
    <!-- SIDEBAR                   -->
    <!-- ========================= -->

    <aside class="sidebar glass">

        <div class="sidebar-top">
            <button
                id="create-btn"
                type="button"
                class="btn btn-create"
                aria-haspopup="dialog"
                aria-expanded="false"
                aria-controls="create-dialog"
            >
                <span
                    class="btn-icon-glyph"
                    aria-hidden="true"
                >
                    +
                </span>

                <span>
                    Créer
                </span>
            </button>
        </div>

        <div class="sidebar-scroll">

            <%- include('partials/error') %>


            <!-- MINI CALENDRIER -->

            <section
                class="mini-cal"
                aria-label="Choisir une semaine"
            >

                <div class="mini-head">

                    <h2 id="mini-label"></h2>

                    <div class="mini-nav">

                        <button
                            id="mini-prev"
                            type="button"
                            class="btn btn-round btn-small"
                            aria-label="Mois précédent"
                        >
                            ‹
                        </button>

                        <button
                            id="mini-next"
                            type="button"
                            class="btn btn-round btn-small"
                            aria-label="Mois suivant"
                        >
                            ›
                        </button>

                    </div>

                </div>


                <div
                    class="mini-weekdays"
                    aria-hidden="true"
                >
                    <span>L</span>
                    <span>M</span>
                    <span>M</span>
                    <span>J</span>
                    <span>V</span>
                    <span>S</span>
                    <span>D</span>
                </div>


                <div
                    id="mini-grid"
                    class="mini-grid"
                ></div>

            </section>


            <!-- LISTE DES AGENDAS -->

            <div class="agenda-groups">
                <section class="agenda-section">
                    <h2 id="own-agendas-title" class="section-title">Mes agendas</h2>
                    <ul
                        id="own-agenda-list"
                        class="agenda-list"
                        role="list"
                        aria-labelledby="own-agendas-title"
                    ></ul>
                    <p id="empty-own-agendas" class="hint" hidden>Aucun agenda personnel.</p>
                </section>

                <section class="agenda-section">
                    <h2 id="shared-agendas-title" class="section-title">Agendas partagés</h2>
                    <ul
                        id="shared-agenda-list"
                        class="agenda-list"
                        role="list"
                        aria-labelledby="shared-agendas-title"
                    ></ul>
                    <p id="empty-shared-agendas" class="hint" hidden>Aucun agenda partagé.</p>
                </section>
            </div>

        </div>

    </aside>


    <!-- ========================= -->
    <!-- CALENDRIER                -->
    <!-- ========================= -->

    <section
        class="calendar glass"
        aria-label="Semaine"
    >

        <p class="calendar-hint calendar-loading" role="status">Chargement du calendrier…</p>

        <p
            id="calendar-hint"
            class="calendar-hint"
        ></p>


        <div
            id="week-body"
            class="week-body"
        >

            <div class="week-head">

                <span
                    id="tz-label"
                    class="tz-label"
                ></span>

                <div
                    id="week-days"
                    class="week-days"
                ></div>

            </div>


            <div class="week-grid">

                <div
                    id="hours"
                    class="hours"
                    aria-hidden="true"
                ></div>

                <div
                    id="week-columns"
                    class="week-columns"
                ></div>

            </div>

        </div>

    </section>

</main>


<!-- ====================================================== -->
<!-- DIALOG : CRÉER / MODIFIER UNE TÂCHE OU UN AGENDA       -->
<!-- ====================================================== -->

<dialog
    id="create-dialog"
    class="create-sheet"
    aria-labelledby="create-title"
>

    <form
        id="create-form"
        class="sheet-form"
        novalidate
    >

        <span
            class="sheet-grabber"
            aria-hidden="true"
        ></span>


        <div class="sheet-head">

            <h2
                id="create-title"
                class="sheet-title visually-hidden"
            >
                Créer
            </h2>


            <div
                id="kind-switch"
                class="segmented"
                role="radiogroup"
                aria-label="Que voulez-vous créer ?"
            >

                <input
                    id="kind-tache"
                    type="radio"
                    name="kind"
                    value="tache"
                    checked
                >

                <label for="kind-tache">
                    Tâche
                </label>


                <input
                    id="kind-agenda"
                    type="radio"
                    name="kind"
                    value="agenda"
                >

                <label for="kind-agenda">
                    Agenda
                </label>


                <span
                    class="segmented-thumb"
                    aria-hidden="true"
                ></span>

            </div>


            <button
                id="close-dialog"
                type="button"
                class="btn btn-glass btn-round"
                aria-label="Fermer"
            >
                ×
            </button>

        </div>


        <!-- ================================================= -->
        <!-- CHAMPS TÂCHE                                      -->
        <!-- ================================================= -->

        <fieldset
            id="tache-fields"
            class="sheet-fields"
        >

            <legend class="visually-hidden">
                Nouvelle tâche
            </legend>


            <div class="sheet-fields-inner">


                <!-- TITRE -->

                <input
                    id="tache-title"
                    type="text"
                    class="title-input"
                    placeholder="Ajouter un titre"
                    aria-label="Titre"
                    autocomplete="off"
                >


                <!-- DATE / HEURES -->

                <div class="field-row">

                    <div class="field">

                        <label for="tache-date">
                            Date
                        </label>

                        <input
                            id="tache-date"
                            type="date"
                        >

                    </div>


                    <div class="field">

                        <label for="tache-start">
                            Début
                        </label>

                        <input
                            id="tache-start"
                            type="time"
                            step="300"
                        >

                    </div>


                    <div class="field">

                        <label for="tache-end">
                            Fin
                        </label>

                        <input
                            id="tache-end"
                            type="time"
                            step="300"
                        >

                    </div>

                </div>


                <!-- ======================================== -->
                <!-- RÉCURRENCE                               -->
                <!-- ======================================== -->

                <div class="field">

                    <label for="tache-recurrence">
                        Récurrence
                    </label>

                    <select id="tache-recurrence">

                        <option value="none">
                            Aucune
                        </option>

                        <option value="daily">
                            Tous les jours
                        </option>

                        <option value="weekly">
                            Toutes les semaines
                        </option>

                        <option value="monthly">
                            Tous les mois
                        </option>

                        <option value="yearly">
                            Tous les ans
                        </option>

                    </select>

                </div>


                <!-- DATE DE FIN DE RÉCURRENCE -->

                <div
                    id="recurrence-end-field"
                    class="field"
                >

                    <label for="tache-recurrence-end">
                        Fin de la récurrence
                    </label>

                    <input
                        id="tache-recurrence-end"
                        type="date"
                    >

                </div>


                <!-- ======================================== -->
                <!-- AGENDAS                                  -->
                <!-- ======================================== -->

                <div class="field">

                    <span
                        id="picker-label"
                        class="field-label"
                    >
                        Agendas
                    </span>


                    <button
                        id="picker-btn"
                        type="button"
                        class="picker-btn"
                        aria-labelledby="picker-label picker-btn"
                        aria-expanded="false"
                        aria-controls="picker-panel"
                    >

                        <span
                            id="picker-chips"
                            class="picker-chips"
                        ></span>

                    </button>


                    <div
                        id="picker-panel"
                        class="picker-panel"
                        inert
                    >

                        <div class="picker-clip">

                            <ul
                                id="picker-options"
                                class="picker-options"
                                aria-label="Agendas de la tâche"
                            ></ul>

                        </div>

                    </div>

                </div>


                <!-- LIEU -->

                <div class="field">

                    <label for="tache-location">
                        Lieu

                        <span class="optional">
                            facultatif
                        </span>
                    </label>

                    <input
                        id="tache-location"
                        type="text"
                        placeholder="Salle 101"
                        autocomplete="off"
                    >

                </div>


                <!-- DESCRIPTION -->

                <div class="field">

                    <label for="tache-description">
                        Description

                        <span class="optional">
                            facultatif
                        </span>
                    </label>

                    <textarea
                        id="tache-description"
                        rows="2"
                        placeholder="Ajouter des détails"
                    ></textarea>

                </div>

            </div>

        </fieldset>


        <!-- ================================================= -->
        <!-- CHAMPS AGENDA                                     -->
        <!-- ================================================= -->

        <fieldset
            id="agenda-fields"
            class="sheet-fields"
            hidden
        >

            <legend class="visually-hidden">
                Nouvel agenda
            </legend>


            <input
                id="agenda-name"
                type="text"
                class="title-input"
                placeholder="Nom de l'agenda"
                aria-label="Nom"
                autocomplete="off"
            >


            <!-- COULEUR -->

            <div class="field">

                <span
                    id="color-label"
                    class="field-label"
                >
                    Couleur
                </span>


                <div
                    class="swatches"
                    role="radiogroup"
                    aria-labelledby="color-label"
                >

                    <% swatches.forEach((swatch, i) => { %>

                        <label
                            class="swatch"
                            style="--swatch: <%= swatch.value %>"
                        >

                            <input
                                type="radio"
                                name="color"
                                value="<%= swatch.value %>"
                                <%= i === 0 ? 'checked' : '' %>
                                aria-label="<%= swatch.name %>"
                            >

                            <span></span>

                        </label>

                    <% }) %>


                    <!-- COULEUR PERSONNALISÉE -->

                    <label
                        class="swatch swatch-custom"
                        title="Autre couleur"
                    >

                        <input
                            id="color-custom-radio"
                            type="radio"
                            name="color"
                            value="#1c1e3a"
                            aria-label="Autre couleur"
                        >

                        <span></span>

                        <input
                            id="color-custom"
                            type="color"
                            value="#1c1e3a"
                            tabindex="-1"
                            aria-hidden="true"
                        >

                    </label>

                </div>

            </div>


            <!-- APERÇU AGENDA -->

            <div
                id="agenda-preview"
                class="agenda-preview"
                aria-hidden="true"
            >

                <span class="agenda-dot"></span>

                <span
                    id="agenda-preview-name"
                    class="agenda-name"
                >
                    Nom de l'agenda
                </span>

            </div>


        </fieldset>


        <!-- MESSAGE D'ERREUR -->

        <p
            id="dialog-error"
            class="error"
            role="alert"
            hidden
        ></p>


        <!-- BOUTONS -->

        <div class="sheet-footer">

            <button
                id="delete-btn"
                type="button"
                class="btn btn-danger"
                hidden
            >
                Supprimer
            </button>


            <button
                id="cancel-btn"
                type="button"
                class="btn btn-glass"
            >
                Annuler
            </button>


            <!-- IMPORT D'AGENDA (.ics) : onglet Agenda uniquement -->

            <button
                id="import-btn"
                type="button"
                class="btn btn-glass import-btn"
                aria-haspopup="dialog"
                aria-controls="import-dialog"
                title="Importer un calendrier depuis un fichier .ics"
                aria-label="Importer un calendrier (.ics)"
                hidden
            >
                <svg
                    viewBox="0 0 20 20"
                    width="16"
                    height="16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="M10 3v9M6.5 8.5 10 12l3.5-3.5"/>
                    <path d="M3.5 13.5v1.5a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2v-1.5"/>
                </svg>
                <span class="import-btn-label">Importer (.ics)</span>
            </button>


            <button
                id="save-btn"
                type="submit"
                class="btn btn-primary"
            >
                Créer la tâche
            </button>

        </div>

    </form>

</dialog>


<!-- ====================================================== -->
<!-- DIALOG : DÉTAIL D'UN ÉVÉNEMENT                         -->
<!-- ====================================================== -->

<dialog
    id="event-dialog"
    class="event-pop"
    aria-labelledby="event-title"
>

    <div class="event-pop-inner">


        <div class="event-pop-head">

            <span
                class="event-pop-dot"
                aria-hidden="true"
            ></span>

            <h2 id="event-title"></h2>

            <button
                id="event-close"
                type="button"
                class="btn btn-glass btn-round btn-small"
                aria-label="Fermer"
            >
                ×
            </button>

        </div>


        <dl class="event-details">


            <!-- DATE -->

            <div class="detail-row">

                <svg
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                >
                    <circle
                        cx="12"
                        cy="12"
                        r="9"
                    />

                    <path d="M12 7v5l3 2"/>
                </svg>

                <dt class="visually-hidden">
                    Quand
                </dt>

                <dd id="event-when"></dd>

            </div>


            <!-- LIEU -->

            <div
                id="event-location-row"
                class="detail-row"
            >

                <svg
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                >
                    <path
                        d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"
                    />

                    <circle
                        cx="12"
                        cy="9.5"
                        r="2.5"
                    />
                </svg>


                <dt class="visually-hidden">
                    Lieu
                </dt>

                <dd id="event-location"></dd>

            </div>


            <!-- AGENDA -->

            <div class="detail-row">

                <svg
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                >
                    <rect
                        x="3.5"
                        y="5"
                        width="17"
                        height="15"
                        rx="3"
                    />

                    <path
                        d="M3.5 10h17M8 3v4M16 3v4"
                    />
                </svg>


                <dt class="visually-hidden">
                    Agenda
                </dt>

                <dd>

                    <span
                        id="event-agenda"
                        class="chip"
                    ></span>

                </dd>

            </div>


            <!-- DESCRIPTION -->

            <div class="detail-row">

                <svg
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                >
                    <path
                        d="M5 6h14M5 11h14M5 16h9"
                    />
                </svg>


                <dt class="visually-hidden">
                    Description
                </dt>

                <dd
                    id="event-description"
                    class="event-description"
                ></dd>

            </div>

        </dl>


        <p
            id="event-error"
            class="error"
            role="alert"
            hidden
        ></p>


        <!-- CHOIX POUR UN ÉVÉNEMENT RÉCURRENT : cette occurrence ou toute la série -->
        <div
            id="event-scope"
            class="event-scope"
            role="group"
            aria-labelledby="event-scope-label"
            hidden
        >
            <p id="event-scope-label" class="event-scope-label"></p>
            <div class="event-actions">
                <button id="event-scope-cancel" type="button" class="btn btn-glass">Annuler</button>
                <button id="event-scope-all" type="button" class="btn btn-glass">Toute la série</button>
                <button id="event-scope-one" type="button" class="btn btn-glass">Cette occurrence</button>
            </div>
        </div>


        <div id="event-main-actions" class="event-actions">

            <button
                id="event-delete"
                type="button"
                class="btn btn-danger"
            >
                Supprimer
            </button>


            <button
                id="event-select"
                type="button"
                class="btn btn-glass"
                title="Sélectionner plusieurs événements (ou Ctrl/⌘ + clic)"
            >
                Sélectionner
            </button>


            <button
                id="event-edit"
                type="button"
                class="btn btn-glass"
            >
                Modifier
            </button>

        </div>

    </div>

</dialog>


<!-- ====================================================== -->
<!-- DIALOG : PARTAGE D'AGENDA                              -->
<!-- ====================================================== -->

<dialog
    id="share-dialog"
    class="event-pop share-pop"
    aria-labelledby="share-title"
>

    <div class="event-pop-inner">


        <div class="event-pop-head">

            <span
                class="event-pop-dot"
                aria-hidden="true"
            ></span>

            <h2 id="share-title"></h2>

            <button
                id="share-close"
                type="button"
                class="btn btn-glass btn-round btn-small"
                aria-label="Fermer"
            >
                ×
            </button>

        </div>


        <form
            id="share-form"
            class="share-form"
            novalidate
        >

            <label
                for="share-username"
                class="visually-hidden"
            >
                Nom d'utilisateur
            </label>


            <input
                id="share-username"
                type="text"
                placeholder="Nom d'utilisateur"
                autocomplete="off"
            >


            <button
                id="share-add"
                type="submit"
                class="btn btn-primary"
            >
                Ajouter
            </button>

        </form>


        <p
            id="share-error"
            class="error"
            role="alert"
            hidden
        ></p>


        <p
            id="share-status"
            class="share-status"
            role="status"
            hidden
        ></p>


        <h3 class="share-subtitle">
            Personnes ayant accès
        </h3>


        <ul
            id="share-list"
            class="share-list"
            aria-label="Personnes ayant accès"
        ></ul>


        <p
            id="share-empty"
            class="share-empty"
        ></p>


        <div class="event-actions">

            <button
                id="share-remove"
                type="button"
                class="btn btn-danger"
                data-label="Retirer"
                disabled
            >
                Retirer
            </button>

        </div>

    </div>

</dialog>


<!-- ====================================================== -->
<!-- DIALOG : IMPORT D'AGENDA (.ics)                        -->
<!-- ====================================================== -->

<dialog
    id="import-dialog"
    class="event-pop import-pop"
    aria-labelledby="import-title"
>

    <form
        id="import-form"
        class="event-pop-inner"
        novalidate
    >

        <div class="settings-section-heading import-heading">
            <span class="settings-section-icon" aria-hidden="true">↑</span>
            <div>
                <h2 id="import-title">Importer un agenda</h2>
                <p>Ajoutez les événements d’un fichier .ics à un nouvel agenda ou à un agenda existant.</p>
            </div>
            <button id="import-close" type="button" class="btn btn-glass btn-round btn-small" aria-label="Fermer">×</button>
        </div>

        <div id="import-drop" class="import-file-field">
            <label id="import-drop-label" for="import-file">Fichier iCalendar</label>
            <input id="import-file" type="file" accept=".ics,text/calendar" aria-describedby="import-file-help">
        </div>
        <p id="import-file-help" class="hint">Format .ics · 1 Mo maximum. Les événements sont vérifiés avant l’import.</p>

        <div id="import-preview" hidden>
            <fieldset class="import-target">
                <legend>Importer dans</legend>
                <label>
                    <input type="radio" name="import-target" value="new" checked>
                    Un nouvel agenda
                </label>
                <label>
                    <input id="import-target-existing" type="radio" name="import-target" value="existing">
                    Un agenda existant
                </label>
            </fieldset>
            <div id="import-new-fields" class="settings-import-fields">
                <div>
                    <label for="import-name">Nom de l’agenda</label>
                    <input id="import-name" type="text" maxlength="200" autocomplete="off" required>
                </div>
                <div>
                    <label for="import-color">Couleur</label>
                    <input id="import-color" type="color" value="#3b82f6">
                </div>
            </div>
            <div id="import-existing-field" class="import-existing-field" hidden>
                <label for="import-agenda">Agenda</label>
                <select id="import-agenda"></select>
            </div>
            <div class="import-select-bar">
                <p id="import-count" class="settings-preview-count"></p>
                <label class="import-select-all">
                    <input id="import-select-all" type="checkbox" checked>
                    Tout sélectionner
                </label>
            </div>
            <ul id="import-list" class="settings-preview-list import-check-list" aria-labelledby="import-count"></ul>

            <ul
                id="import-warnings"
                class="import-warnings"
                hidden
            ></ul>

        </div>


        <p
            id="import-error"
            class="error"
            role="alert"
            hidden
        ></p>


        <div class="event-actions">

            <button
                id="import-submit"
                type="submit"
                class="btn btn-primary"
                disabled
            >
                Importer l’agenda
            </button>

        </div>

    </form>

</dialog>


<!-- SCRIPT -->

<dialog id="agenda-menu" class="event-pop agenda-actions-menu" aria-label="Actions de l'agenda">
    <div class="event-pop-inner">
        <button id="agenda-menu-edit" type="button">Modifier l’agenda</button>
        <button id="agenda-menu-share" type="button">Partager l’agenda</button>
        <button id="agenda-menu-export" type="button">Exporter en .ics</button>
        <button id="agenda-menu-import" type="button">Importer des événements (.ics)</button>
    </div>
</dialog>

<!-- BARRE DE SÉLECTION MULTIPLE D'ÉVÉNEMENTS -->
<div
    id="selection-bar"
    class="selection-bar glass"
    role="region"
    aria-label="Événements sélectionnés"
    hidden
>
    <span id="selection-count" class="selection-count" aria-live="polite"></span>
    <div class="selection-target">
        <label for="selection-agenda" class="visually-hidden">Agenda de destination</label>
        <select id="selection-agenda"></select>
    </div>
    <button id="selection-move" type="button" class="btn btn-glass">Déplacer</button>
    <button id="selection-copy" type="button" class="btn btn-glass">Dupliquer</button>
    <button id="selection-clear" type="button" class="btn btn-glass btn-round" aria-label="Annuler la sélection" title="Annuler la sélection (Échap)">×</button>
    <p id="selection-error" class="error selection-error" role="alert" hidden></p>
</div>

<%- include('partials/scripts', { script: 'agendas.js' }) %>

</body>
</html>
